# Every pinned version in one place. Bump here, not in the build scripts.
#
# Pins that are LOAD-BEARING (do not "update to latest" without reading docs/gotchas.md):
#   CMAKE_VER          3.x on purpose — CMake 4 dropped cmake_minimum_required(<3.5)
#   LIBDISPLAY_INFO_VER 0.2.0 — aquamarine's declared floor; pre-1.0 API breaks between minors
#   RE2_TAG            pre-Abseil — newer re2 drags in Abseil, which would need its own libc++ rebuild
#   TOMLPLUSPLUS_TAG   3.4.0+ — 3.3.0 ships toml++/toml.h, hyprcursor includes toml++/toml.hpp
#   CAIRO_VER          >=1.17.2 — CAIRO_FORMAT_RGB96F; bookworm has 1.16.0
#   LUA_VER            5.5.x exactly — Hyprland pins >=5.5,<5.6; Debian maxes at 5.4.4
#   XKBCOMMON_TAG      >=1.11.0 required by Hyprland; bookworm has 1.5.0
#   LIBINPUT_TAG       >=1.29 required by Hyprland (aquamarine only asks 1.26)
#   SEATD_TAG          libseat >=0.8.0 required by aquamarine; bookworm has 0.7.0

PREFIX="${PREFIX:-/opt/hypr}"
WAYBAR_PREFIX="${WAYBAR_PREFIX:-/opt/waybar}"
SRC_DIR="${SRC_DIR:-$HOME/hyprland-build/src}"

# --- build tooling ---
CMAKE_VER=3.31.6

# --- C core ---
WAYLAND_VER=1.26.0
WAYLAND_PROTOCOLS_VER=1.49
LIBDRM_TAG=libdrm-2.4.134
LIBDISPLAY_INFO_VER=0.2.0
XCB_UTIL_ERRORS_VER=1.0.1
XKBCOMMON_TAG=xkbcommon-1.13.2
LIBINPUT_TAG=1.30.4
SEATD_TAG=0.9.3
LIBEI_TAG=1.6.0
CAIRO_VER=1.18.4

# --- C++ deps (must be built with libc++, see docs/why-libcxx.md) ---
GLSLANG_TAG=vulkan-sdk-1.4.357.0
RE2_TAG=2022-06-01
MUPARSER_TAG=v2.3.5
TOMLPLUSPLUS_TAG=v3.4.0
SDBUS_CPP_TAG=v2.3.1
DATE_TAG=v3.0.1

# --- lua ---
LUA_VER=5.5.1

# --- hyprwm stack ---
HYPRWAYLAND_SCANNER_TAG=v0.4.6
HYPRUTILS_TAG=v0.14.2
HYPRLANG_TAG=v0.6.8
HYPRCURSOR_TAG=v0.1.13
HYPRGRAPHICS_TAG=v0.5.1
AQUAMARINE_TAG=v0.15.1
HYPRWIRE_TAG=v0.3.1
HYPRLAND_PROTOCOLS_TAG=v0.7.1
HYPRLAND_TAG=v0.56.2
HYPRLOCK_TAG=v0.9.6

# --- launcher ---
# 1.12 not 1.8.2 (the deb): mouse support, match-mode, placeholder/counter
# colours. NOTE it needs wayland-protocols >= 1.32 — bookworm has 1.31, so it
# must be built against the prefix, not the system.
FUZZEL_TAG=1.12.0

# --- bar ---
WAYBAR_TAG=0.15.0
