# Sourced by every build shell AND by nothing at runtime (binaries find their
# libraries through the rpath baked in at link time).
export PREFIX=@PREFIX@
export PATH=$PREFIX/bin:$PATH
export PKG_CONFIG_PATH=$PREFIX/lib/x86_64-linux-gnu/pkgconfig:$PREFIX/lib/pkgconfig:$PREFIX/share/pkgconfig
export LD_LIBRARY_PATH=$PREFIX/lib/x86_64-linux-gnu:$PREFIX/lib
export CC=clang-19
export CXX=clang++-19
export CXXFLAGS="-stdlib=libc++"
# Both rpath entries are required: meson installs into lib/x86_64-linux-gnu
# (Debian multiarch), autotools into plain lib.
export LDFLAGS="-stdlib=libc++ -Wl,-rpath,$PREFIX/lib/x86_64-linux-gnu -Wl,-rpath,$PREFIX/lib"
